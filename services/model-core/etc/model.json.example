{
  "providers": [
    {
      "name": "openai",
      "type": "openai-compatible",
      "base_url": "https://api.openai.com/v1",
      "api_key_env": "OPENAI_API_KEY",
      "timeout": "2m",
      "models": [
        {
          "id": "gpt-5-mini",
          "streaming": true,
          "tool_calling": true,
          "parallel_tool_calling": true,
          "structured_output": true
        }
      ]
    }
  ]
}
